  "template": {
    "number": "{{VERSION}}",
    "type": "{{TYPE}}",
    "date": "{{DATE}}",
    "tags": {{TAGS_JSON}},
    "pages": {{PAGES_JSON}},
    "prototypeUrl": "/{{VERSION_ID}}/",
    "userFlowUrl": null,
    "designHistoryUrl": null
  },
  "notes": {
    "type": "One of: 'release', 'in-development', 'research', 'snapshot'. Use 'snapshot' for a version that was not tested because the design moved on before research took place",
    "date": "Examples: 'TBC', 'In development', 'Release - 22 January 2026', 'Research round - January 2026', 'Design snapshot - not tested'",
    "tags": "Array of tag strings. Add/update as features are finalized",
    "pages": "Array of objects with 'name' and 'url'. Add/update as pages are created",
    "userFlowUrl": "Set to the version's user flow page when it has one. Format: '/v3-9-0-0/user-flow'",
    "designHistoryUrl": "Set to design history URL when post is published. Format: '/design-history/3-9-0-0/'"
  },
  "examples": {
    "release_with_tags": {
      "number": "3.9.0.0",
      "type": "release",
      "date": "Release - 22 January 2026",
      "tags": ["draw-boundary", "map-styling", "scale-bar"],
      "pages": [
        { "name": "Start page", "url": "/v3-9-0-0/" },
        { "name": "Map page", "url": "/v3-9-0-0/map" }
      ],
      "prototypeUrl": "/v3-9-0-0/",
      "designHistoryUrl": "/design-history/3-9-0-0/"
    },
    "in_development_empty": {
      "number": "3.10.0.0",
      "type": "in-development",
      "date": "In development",
      "tags": [],
      "pages": [],
      "prototypeUrl": "/v3-10-0-0/",
      "designHistoryUrl": null
    },
    "research_round": {
      "number": "draw-boundary-testing",
      "type": "research",
      "date": "Research round - February 2026",
      "tags": ["draw-boundary", "user-research"],
      "pages": [
        { "name": "Prototype", "url": "/research/draw-boundary-testing/" }
      ],
      "prototypeUrl": "/research/draw-boundary-testing/",
      "designHistoryUrl": "/design-history/draw-boundary-testing/"
    },
    "design_snapshot": {
      "number": "3.9.0.1",
      "type": "snapshot",
      "date": "Design snapshot - not tested",
      "tags": ["product-1"],
      "pages": [
        { "name": "Product 1", "url": "/v3-9-0-1/product1" }
      ],
      "prototypeUrl": "/v3-9-0-1/product1",
